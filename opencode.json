{
  "$schema": "https://opencode.ai/config.json",
  "model": "puter.js/claude-sonnet-4",
  "disabled_providers": ["openrouter"],
  "provider": {
    "puter.js": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "puter"
      },
      "models": {
        "claude-sonnet-4": { "name": "Claude Sonnet 4" },
        "claude-opus-4": { "name": "Claude Opus 4" },
        "claude-3-7-sonnet": { "name": "Claude 3.7 Sonnet" }
      }
    }
  },
  "agent": {
    "puter.js": {
      "description": "Puter.js Claude models (claude-sonnet-4, claude-opus-4, claude-3-7-sonnet). Requires run_server.bat + Claude.html browser authentication.",
      "mode": "all",
      "model": "puter.js/claude-sonnet-4"
    }
  }
}
